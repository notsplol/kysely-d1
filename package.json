{
  "name": "@notsplol/kysely-d1",
  "description": "Kysely dialect for Cloudflare D1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "version": "0.6.1",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/notsplol/kysely-d1.git"
  },
  "author": "Shivam Patel <shivam.patel.nvim@gmail.com>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kysely",
    "cloudflare",
    "d1",
    "workers",
    "serverless"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "check": "prettier --check src/ example/",
    "format": "prettier --write src/ example/"
  },
  "peerDependencies": {
    "kysely": ">=0.27.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@cloudflare/workers-types": "^4.20260608.1",
    "kysely": "^0.29.2",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
